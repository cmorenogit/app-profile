---
import { Navigation } from './Navigation';
---

<header class="pt-6 lg:sticky lg:top-0 lg:flex lg:h-screen lg:w-2/5 lg:flex-col lg:justify-between lg:py-24 lg:pt-24">
  <div>
    <div class="mb-4">
      <span class="status-badge">Building AI products, end to end</span>
    </div>

    <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
      <a href="/" class="gradient-text">Cesar Moreno</a>
    </h1>
    <h2 class="mt-3 text-lg font-medium tracking-tight text-white sm:text-xl">
      Principal Engineer &middot; AI Systems &amp; Product
    </h2>
    <p class="mt-1 font-mono text-sm text-accent-secondary">
      I build the right product with AI — and ship it to production fast
    </p>
    <p class="mt-4 max-w-xs leading-relaxed text-slate-light">
      13 years of senior engineering. I pair real product judgment with applied
      AI to build what actually moves your business — and ship it fast.
    </p>

    <div class="mt-12 lg:mt-16">
      <Navigation client:load />
    </div>
  </div>

  <div class="mt-6 mb-8 lg:mt-0 lg:mb-0">
    <ul class="flex gap-5 font-mono text-xs uppercase tracking-widest text-slate">
      <li><a href="https://linkedin.com/in/morenodev" class="hover:text-accent transition-colors">LinkedIn</a></li>
      <li><a href="https://github.com/cmorenogit" class="hover:text-accent transition-colors">GitHub</a></li>
    </ul>
  </div>
</header>
