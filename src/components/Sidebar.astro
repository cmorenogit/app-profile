---
import { Navigation } from './Navigation';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const navLabels = {
  approach: t('nav.approach'),
  work: t('nav.work'),
  built: t('nav.built'),
  experience: t('nav.experience'),
  contact: t('nav.contact'),
};

const enHref = getLocalizedPath(Astro.url, 'en');
const esHref = getLocalizedPath(Astro.url, 'es');
const homeHref = lang === 'es' ? '/es' : '/';
---

<header class="pt-6 lg:sticky lg:top-0 lg:flex lg:h-screen lg:w-2/5 lg:flex-col lg:justify-between lg:py-24 lg:pt-24">
  <div>
    <nav aria-label={t('lang.switch.aria')} class="mb-5 flex items-center gap-1 font-mono text-xs uppercase tracking-widest">
      <a
        href={enHref}
        aria-current={lang === 'en' ? 'true' : undefined}
        class={`transition-colors ${lang === 'en' ? 'text-accent' : 'text-slate hover:text-white'}`}
      >EN</a>
      <span class="text-slate/40" aria-hidden="true">/</span>
      <a
        href={esHref}
        aria-current={lang === 'es' ? 'true' : undefined}
        class={`transition-colors ${lang === 'es' ? 'text-accent' : 'text-slate hover:text-white'}`}
      >ES</a>
    </nav>

    <div class="mb-4">
      <span class="status-badge">{t('sidebar.badge')}</span>
    </div>

    <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
      <a href={homeHref} class="gradient-text">Cesar Moreno</a>
    </h1>
    <h2 class="mt-3 text-lg font-medium tracking-tight text-white sm:text-xl">
      {t('sidebar.role')}
    </h2>
    <p class="mt-1 font-mono text-sm text-accent-secondary">
      {t('sidebar.tagline')}
    </p>
    <p class="mt-4 max-w-xs leading-relaxed text-slate-light">
      {t('sidebar.description')}
    </p>

    <div class="mt-12 lg:mt-16">
      <Navigation client:load labels={navLabels} />
    </div>
  </div>

  <div class="mt-6 mb-8 lg:mt-0 lg:mb-0">
    <ul class="flex gap-5 font-mono text-xs uppercase tracking-widest text-slate">
      <li><a href="https://linkedin.com/in/morenodev" class="hover:text-accent transition-colors">LinkedIn</a></li>
      <li><a href="https://github.com/cmorenogit" class="hover:text-accent transition-colors">GitHub</a></li>
    </ul>
  </div>
</header>
