---
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Projects has a localized route; the playground stays at its English route for now.
const projectsHref = lang === 'es' ? '/es/projects' : '/projects';
---

<section id="built" class="fade-in scroll-mt-24">
  <h2 class="mb-2 text-sm font-bold uppercase tracking-[0.1em] text-white">{t('built.heading')}</h2>
  <p class="mb-5 text-sm text-slate">{t('built.subtitle')}</p>
  <div class="space-y-4">
    <div class="glass-card p-6">
      <div class="flex items-baseline justify-between gap-4">
        <h3 class="font-semibold text-white">Agentes Hub</h3>
        <span class="font-mono text-xs uppercase tracking-wide text-accent shrink-0">97.5% token savings</span>
      </div>
      <p class="mt-3 text-sm text-slate-light">
        {t('built.agentes.body')}
      </p>
      <div class="mt-3 flex flex-wrap gap-2">
        <span class="tech-tag">TypeScript</span><span class="tech-tag">LangChain</span><span class="tech-tag">Multi-LLM</span>
      </div>
    </div>
    <div class="glass-card p-6">
      <div class="flex items-baseline justify-between gap-4">
        <h3 class="font-semibold text-white">ContextForge</h3>
        <span class="font-mono text-xs uppercase tracking-wide text-slate shrink-0">Rust · MCP</span>
      </div>
      <p class="mt-3 text-sm text-slate-light">
        {t('built.contextforge.body')}
      </p>
      <div class="mt-3 flex flex-wrap gap-2">
        <span class="tech-tag">Rust</span><span class="tech-tag">Vector search</span><span class="tech-tag">MCP</span>
      </div>
    </div>
    <div class="glass-card p-6">
      <div class="flex items-baseline justify-between gap-4">
        <h3 class="font-semibold text-white">Claude Statusline</h3>
        <span class="font-mono text-xs uppercase tracking-wide text-slate shrink-0">npm</span>
      </div>
      <p class="mt-3 text-sm text-slate-light">
        {t('built.statusline.body')}
      </p>
      <div class="mt-3 flex flex-wrap gap-2">
        <span class="tech-tag">Node.js</span><span class="tech-tag">CLI</span><span class="tech-tag">npm</span>
      </div>
    </div>
    <div class="glass-card border-l-2 border-accent/40 p-6 text-center">
      <h3 class="font-semibold text-white">{t('built.playground.title')}</h3>
      <p class="mx-auto mt-2 max-w-md text-sm text-slate-light">
        {t('built.playground.body.pre')}<span class="text-white">{t('built.playground.body.highlight')}</span>{t('built.playground.body.post')}
      </p>
      <a href="/playground" class="mt-4 inline-block rounded-lg border border-accent/30 bg-accent/10 px-5 py-2.5 font-mono text-xs font-semibold uppercase tracking-wide text-accent transition hover:bg-accent/20">{t('built.playground.cta')}</a>
    </div>
  </div>
  <p class="mt-5 text-center">
    <a href={projectsHref} class="font-mono text-xs uppercase tracking-widest text-slate transition-colors hover:text-accent">{t('built.seeAll')}</a>
  </p>
</section>
