---
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="experience" class="fade-in scroll-mt-24">
  <h2 class="mb-4 text-sm font-bold uppercase tracking-[0.1em] text-white">{t('experience.heading')}</h2>
  <div class="glass-card p-6 space-y-3">
    <p class="text-slate-light">
      {t('experience.p1.pre')}<em class="not-italic text-white">{t('experience.p1.highlight')}</em>{t('experience.p1.post')}
    </p>
    <p class="text-slate-light">
      {t('experience.p2.pre')}<span class="text-white">{t('experience.p2.highlight')}</span>{t('experience.p2.post')}
    </p>
  </div>
</section>
