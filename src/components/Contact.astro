---
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="contact" class="fade-in scroll-mt-24">
  <div class="glass-card p-8 text-center">
    <h2 class="text-2xl font-bold text-white">{t('contact.heading')}</h2>
    <p class="mx-auto mt-3 max-w-md text-slate-light">
      {t('contact.body')}
      <span class="mt-2 block text-sm text-slate">{t('contact.subtext')}</span>
    </p>
    <a href="mailto:hello@cesarmoreno.dev" class="mt-6 inline-flex items-center gap-2 rounded-lg border border-accent/30 bg-accent/10 px-6 py-3 font-mono text-sm font-semibold text-accent transition hover:bg-accent/20">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/></svg>
      {t('contact.cta')}
    </a>
  </div>
  <p class="mt-8 text-center font-mono text-xs text-slate lg:mt-[35vh]">{t('contact.byline')}</p>
</section>
