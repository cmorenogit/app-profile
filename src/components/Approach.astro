---
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="approach" class="fade-in scroll-mt-24">
  <span class="section-heading lg:hidden">{t('nav.approach')}</span>
  <h2 class="text-2xl font-bold leading-snug text-white sm:text-3xl">
    {t('approach.heading.pre')}<span class="gradient-text">{t('approach.heading.highlight')}</span>{t('approach.heading.post')}
  </h2>
  <p class="mt-5 text-slate-light">
    {t('approach.body.pre')}<em class="text-white not-italic font-medium">{t('approach.body.highlight')}</em>{t('approach.body.mid')}<span class="text-white font-medium">{t('approach.body.emph')}</span>{t('approach.body.post')}
  </p>
  <div class="mt-8 grid gap-4 sm:grid-cols-3">
    <div class="glass-card p-5">
      <h3 class="font-semibold text-white">{t('approach.pillar1.title')}</h3>
      <p class="mt-2 text-sm text-slate">{t('approach.pillar1.body')}</p>
    </div>
    <div class="glass-card p-5">
      <h3 class="font-semibold text-white">{t('approach.pillar2.title')}</h3>
      <p class="mt-2 text-sm text-slate">{t('approach.pillar2.body')}</p>
    </div>
    <div class="glass-card p-5">
      <h3 class="font-semibold text-white">{t('approach.pillar3.title')}</h3>
      <p class="mt-2 text-sm text-slate">{t('approach.pillar3.body')}</p>
    </div>
  </div>
  <p class="mt-6 font-mono text-sm text-accent-secondary">{t('approach.signature')}</p>
</section>
