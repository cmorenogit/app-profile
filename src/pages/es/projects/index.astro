---
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import { featuredProjects } from '@/data/projects';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const homeHref = lang === 'es' ? '/es' : '/';
---

<Layout title={t('meta.projects.title')} description={t('meta.projects.description')}>
  <div class="mx-auto max-w-3xl px-6 py-16 md:px-12 md:py-24">
    <a href={homeHref} class="font-mono text-xs uppercase tracking-widest text-accent transition-colors hover:text-accent-hover">{t('projects.back')}</a>
    <h1 class="mt-6 text-3xl font-bold tracking-tight text-white sm:text-4xl">{t('projects.heading')}</h1>
    <p class="mt-3 max-w-xl text-slate-light">{t('projects.subtitle')}</p>

    <div class="mt-10 space-y-4">
      {featuredProjects.map((p) => (
        <a href={`/projects/${p.slug}`} class="group block glass-card p-6">
          <div class="flex items-baseline justify-between gap-4">
            <h2 class="font-semibold text-white transition-colors group-hover:text-accent">{p.title}</h2>
            <span class="shrink-0 font-mono text-xs uppercase tracking-wide text-slate">{p.madeAt}{p.year ? ` · ${p.year}` : ''}</span>
          </div>
          <p class="mt-3 text-sm text-slate-light">{p.description}</p>
          {p.technologies?.length ? (
            <div class="mt-3 flex flex-wrap gap-2">
              {p.technologies.map((t) => <span class="tech-tag">{t}</span>)}
            </div>
          ) : null}
        </a>
      ))}
    </div>
  </div>
</Layout>
