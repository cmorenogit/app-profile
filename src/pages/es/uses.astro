---
import Layout from '@/layouts/Layout.astro';
import { SpotlightCursor } from '@/components/SpotlightCursor';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import { usesCategories } from '@/data/uses';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const homeHref = lang === 'es' ? '/es' : '/';
const categories = usesCategories[lang];
---

<Layout
  title={t('meta.uses.title')}
  description={t('meta.uses.description')}
>
  <SpotlightCursor client:media="(min-width: 1024px)" />
  <main class="mx-auto max-w-3xl px-6 py-24 md:px-12 lg:px-24">
    <a
      href={homeHref}
      class="group mb-6 inline-flex items-center gap-2 font-mono text-sm text-accent transition-colors hover:text-accent-hover"
    >
      <span class="transition-transform group-hover:-translate-x-1">&larr;</span>
      {t('common.backHome')}
    </a>

    <h1 class="text-4xl font-bold sm:text-5xl">
      <span class="gradient-text">{t('uses.heading')}</span>
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-slate-light">
      {t('uses.intro.pre')}<a href="https://uses.tech" target="_blank" rel="noopener" class="text-accent hover:text-accent-hover transition-colors">{t('uses.intro.link')}</a>.
    </p>

    <div class="mt-12 space-y-12">
      {categories.map((category) => (
        <section>
          <h2 class="mb-4 font-mono text-sm tracking-widest text-accent uppercase">
            {category.title}
          </h2>
          <div class="space-y-1">
            {category.items.map((item) => (
              <div class="group rounded-lg px-4 py-3 transition-colors hover:bg-navy-light/50">
                <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-3">
                  <span class="shrink-0 font-medium text-white">{item.name}</span>
                  <span class="text-sm text-slate">{item.description}</span>
                </div>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>
  </main>
</Layout>
